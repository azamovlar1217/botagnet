# --- Telegram bot (@BotFather dan) ---
BOT_TOKEN=123456:ABC-xxxxxxxx

# Sizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz)
OWNER_ID=123456789
OWNER_NAME=Aziz
# Avto-javoblar uchun o'zingiz haqingizda qisqa ma'lumot (ixtiyoriy)
OWNER_ABOUT=Dasturchiman, odatda kechqurun javob beraman.

# --- Qo'ng'iroqchi akkaunt (my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789

# --- Gemini AI (aistudio.google.com/apikey -> Create API key, bepul) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# --- Kontaktlar: nom=telefon yoki @username yoki ID (vergul bilan) ---
# "men" = OWNER_ID (raqamingiz). Boshqalar TEO kabi qo'ng'iroqchi akkaunt kontaktlarida bo'lsin
CONTACTS=men=123456789,onam=+998902222222,otam=+998903333333

# Har kuni avtomatik salom qo'ng'irog'i (bo'sh qoldirsangiz o'chadi)
DAILY_CALLS=

TIMEZONE=Asia/Tashkent
# Ovoz: uz-UZ-MadinaNeural (ayol) yoki uz-UZ-SardorNeural (erkak)
TTS_VOICE=uz-UZ-MadinaNeural
CALL_TIMEOUT=120

# Qo'ng'iroqlar: 1 = yoqiq, 0 = o'chiq
ENABLE_CALLS=1

# ===================== v2 =====================
# Oila a'zolari (ixtiyoriy). Osonroq yo'l: botga /taklif onam yozing va havolani onangizga yuboring
FAMILY=
# Bozor kuni eslatmasi onamga: 0=dushanba ... 6=yakshanba
BOZOR_DAY=6
BOZOR_TIME=07:30
# Har kuni ertalab ob-havo + kurs + eslatmalar (masalan 08:00; bo'sh = o'chiq)
MORNING_BRIEF=08:00
CITY=Toshkent
# Tezlik: minimal / low / medium / high (bo'sh = model o'zi tanlaydi)
THINKING_LEVEL=low
# Asosiy model band bo'lsa zaxira modellar (vergul bilan)
FALLBACK_MODELS=gemini-flash-lite-latest
AI_TIMEOUT=90

# ===================== v2.1 =====================
# Qo'ng'iroqda ovozni avtomatik kuchaytirish (past ovoz ham eshitilsin). 1 = o'chiq
LIVE_AGC_MAX_GAIN=6
LIVE_AGC_TARGET=3000
# Gap tugadi deb hisoblash uchun sukut (ms). Sekin gapiradiganlar uchun kattaroq
LIVE_SILENCE_MS=1000
# Qo'shimcha bepul Gemini kalitlari botda: /api_qosh AIza...  (faqat egasi)
