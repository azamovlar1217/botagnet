# --- Telegram bot (@BotFather dan) ---
BOT_TOKEN=123456:ABC-xxxxxxxx

# Sizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz)
OWNER_ID=123456789
OWNER_NAME=Aziz
# Avto-javoblar uchun o'zingiz haqingizda qisqa ma'lumot (ixtiyoriy)
OWNER_ABOUT=Dasturchiman, odatda kechqurun javob beraman.

# --- Qo'ng'iroqchi akkaunt (my.telegram.org -> API development tools) ---
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789

# --- Gemini AI (aistudio.google.com/apikey -> Create API key, bepul) ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# --- Kontaktlar: nom=telefon yoki @username yoki ID (vergul bilan) ---
# "men" = OWNER_ID (raqamingiz). Boshqalar TEO kabi qo'ng'iroqchi akkaunt kontaktlarida bo'lsin
CONTACTS=men=123456789,onam=+998902222222,otam=+998903333333

# Har kuni avtomatik salom qo'ng'irog'i (bo'sh qoldirsangiz o'chadi)
DAILY_CALLS=

TIMEZONE=Asia/Tashkent
# Ovoz: uz-UZ-MadinaNeural (ayol) yoki uz-UZ-SardorNeural (erkak)
TTS_VOICE=uz-UZ-MadinaNeural
CALL_TIMEOUT=120

# Qo'ng'iroqlar: 1 = yoqiq, 0 = o'chiq
ENABLE_CALLS=1
